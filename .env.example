# Salin file ini menjadi `.env` lalu isi dengan nilai yang sesuai.
# JANGAN pernah commit `.env` — hanya `.env.example` ini yang boleh masuk git.

# Key Jerexd default — digunakan HANYA untuk dev lokal (disuntikkan oleh Vite dev-proxy
# di sisi Node, tidak pernah ter-bake ke bundle browser).
# Produksi: set sebagai SECRET `JEREXD_API_KEY` di Cloudflare Pages
# (Settings → Environment variables → Production → tambah sebagai Secret),
# lalu CF Pages Function /api/proxy/* yang menyuntikkannya server-side.
JEREXD_API_KEY=

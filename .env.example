# Salin file ini menjadi `.env` lalu isi dengan nilai yang sesuai.
# JANGAN pernah commit `.env` — hanya `.env.example` ini yang boleh masuk git.
#
# Key Jerexd default (fallback) — dipakai jika user belum mengisi key sendiri.
# Lokal: Vite baca dari `.env`. Produksi: set sebagai env var di Cloudflare Pages
# (Settings → Environment variables) dengan nama yang sama.
VITE_JEREXD_DEFAULT_KEY=
